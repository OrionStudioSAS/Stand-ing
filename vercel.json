{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "stand-ing.vercel.app" }],
      "destination": "https://configurateur3d.stand-ing.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
