{
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "stand-ing.vercel.app" },
        { "type": "query", "key": "scene", "value": "(?<scene>.*)" }
      ],
      "destination": "https://configurateur3d.stand-ing.com/?scene=:scene",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "stand-ing.vercel.app" }],
      "destination": "https://configurateur3d.stand-ing.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
