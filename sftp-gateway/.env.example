# HTTP server
PORT=8787
PUBLIC_ALLOWED_ORIGINS=https://stand-ing.vercel.app,http://localhost:5173
GATEWAY_API_TOKEN=change-me-with-a-long-random-token
MAX_UPLOAD_MB=800

# Supabase: used to validate the connected exhibitor/admin and to register HD files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Optional: only needed for server-to-server uploads with GATEWAY_API_TOKEN.
SUPABASE_SERVICE_ROLE_KEY=

# Stand-ING SFTP
SFTP_HOST=sftpstanding.synology.me
SFTP_PORT=2200
SFTP_USERNAME=configurator_upload
SFTP_PASSWORD=replace-with-1password-secret
SFTP_BASE_DIR="/Stand-ING SFTP"
